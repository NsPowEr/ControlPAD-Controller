{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/block_captures.sh\"",
            "timeout": 10,
            "statusMessage": "Checking USB captures"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/localization_parity.sh\" 2>/dev/null || true",
            "timeout": 15,
            "statusMessage": "Checking it/en parity"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(swift build:*)",
      "Bash(swift test:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(./ControlPadGUI/scripts/make_app_bundle.sh)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)"
    ],
    "deny": [
      "Edit(//**/*.pcapng)",
      "Write(//**/*.pcapng)"
    ]
  }
}
